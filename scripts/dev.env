# Local Cloud Agent development environment variables (NATIVE services, not Docker).
#
# These are non-secret, localhost-only development defaults used when running the
# NeuroBet stack directly on the Cloud Agent VM (Postgres + backend + ai_service +
# Next.js), instead of via docker-compose. Real deployments still use docker-compose
# with values from a private .env — this file only exists so a fresh agent can bring
# the stack up locally without any manual configuration.
#
# Sourced by scripts/cloud-agent-install.sh, scripts/cloud-agent-start.sh, and the
# environment's `terminals` service commands.

# Postgres (cluster created locally by the install script; credentials are local-only).
POSTGRES_USER=autobet
POSTGRES_PASSWORD=autobet
POSTGRES_DB=autobet
DATABASE_URL=postgresql://autobet:autobet@localhost:5432/autobet

# Backend <-> AI service wiring (both run on localhost here, not on the docker network).
AI_SERVICE_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000
SCRAPE_INTERVAL_SECONDS=60

# Frontend: the Next.js server proxies /api/* to the backend over localhost. basePath
# stays "/neurobet" (next.config.ts falls back to it), so the UI is served under
# http://localhost:3000/neurobet — matching production.
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/neurobet
NEXT_PUBLIC_BASE_PATH=/neurobet
