# ==========================================
# NeuroBet System Environment Template
# ==========================================

# Postgres Settings
POSTGRES_USER=autobet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=autobet
DATABASE_URL=postgresql://autobet:change_me@postgres:5432/autobet

# Optional: shared finished archive (dev stack points to prod Postgres via ARCHIVE_DATABASE_URL)
# ARCHIVE_DATABASE_URL=postgresql://autobet:change_me@postgres:5432/autobet

# Backend Settings
SCRAPE_INTERVAL_SECONDS=60

# AI Training Tuning (ai_service/app/neuralbet/{pipeline,model}.py) — cadence and batch
# sizing for the online trainer. Defaults below match what's currently running in
# production; see those files' comments at each constant's definition for why. Safe to
# omit entirely — every one of these falls back to the same default in code if unset.
NEURALBET_TRAIN_EVERY_CYCLES=20
NEURALBET_TRAIN_CATCHUP_EVERY_CYCLES=2
NEURALBET_TRAIN_CATCHUP_UNTIL_RATIO=0.80
NEURALBET_MIN_TRAIN_SAMPLES=2000
NEURALBET_MIN_FRESH_SAMPLES=500
# Online GRU pass size (was 10000; 5000 is faster on CPU without starving live).
NEURALBET_TRAIN_BATCH_TOTAL=5000
NEURALBET_LIVE_QUALITY_GATE=1
NEURALBET_LIVE_QUALITY_MIN_BETS=40
NEURALBET_VAL_BATCH_LIMIT=2000
NEURALBET_BATCH_SIZE=256
NEURALBET_LGB_TRAIN_LIMIT=40000
NEURALBET_LGB_REFIT_EVERY_CYCLES=20
NEURALBET_LGB_MIN_FRESH_SAMPLES=500
NEURALBET_LGB_MAX_AGE_HOURS=1
NEURALBET_LGB_SEED=42
NEURALBET_LGB_BRIER_TOLERANCE=0.001
NEURALBET_TUNE_EVERY_CYCLES=10
# Share of TRAIN_BATCH_TOTAL drawn from trained_count=0 (rest = replay).
# 0.45 leaves a majority replay so online GRU cannot memorize a 100% fresh slice.
NEURALBET_TRAIN_FRESH_SHARE=0.45
# Fraction of the online batch from current Brier-gate sports (rest of universe stays).
NEURALBET_TRAIN_STAKE_SPORT_SHARE=0.60
# Comma list / single sport / * = all ALLOWED_SPORT. Ceiling for the Brier sport
# gate (a sport can auto-join when its Brier starts beating the market).
NEURALBET_LIVE_STAKE_SPORTS=настольный теннис,теннис,баскетбол,футбол,волейбол
NEURALBET_BRIER_SPORT_GATE=1
# Model Brier must be this much below market (filters out 0.202 vs 0.203 noise).
NEURALBET_BRIER_SPORT_MARGIN=0.005
NEURALBET_BRIER_SPORT_MIN_EVALUATED=2000
# Walk-forward ROI CI lo must be > 0 on at least this many bets (else sport stays out).
NEURALBET_BRIER_SPORT_MIN_BETS=40
NEURALBET_BRIER_SPORT_REQUIRE_ROI_LO=1
# Stake only if calibrated EV ≥ this percent.
NEURALBET_MIN_BET_EDGE_PCT=5.0
# Stake only if calibrated win probability ≥ this (0–1). 0 = off.
NEURALBET_MIN_STAKE_P=0.75
# Stake coefficient band (training still caps at MAX=2.0).
NEURALBET_MIN_BET_COEFF=1.1
NEURALBET_MAX_BET_COEFF=2.0
# Tail 2.0–2.5 only when calibrated p ≥ HIGH_P_STAKE. Set HIGH_P max to 2.0 to disable.
NEURALBET_MAX_BET_COEFF_HIGH_P=2.5
NEURALBET_HIGH_P_STAKE=0.90
# Falling coeff (steam in) nudges calibrated p up; rising coeff nudges down. 0 = off.
NEURALBET_COEFF_MOVE_P_WEIGHT=0.15
# Mix calibrated p toward 1/coeff after sibling renorm (0 = off).
NEURALBET_MARKET_SHRINK=0.25
# Ensemble: market_weight cannot fall below this (deficit taken from GRU blend).
NEURALBET_MARKET_WEIGHT_FLOOR=0.70
# Reject online GRU checkpoints whose best_epoch is below this (1–2 = memorization).
NEURALBET_CHECKPOINT_MIN_BEST_EPOCH=3
# In-band Brier loss weight on the win head (live coeff band).
NEURALBET_BRIER_LOSS_WEIGHT=1.0
# Live staking markets only (training/inference still use full universe).
# totals = total_over+total_under; * / all = every family; or comma list.
NEURALBET_LIVE_STAKE_MARKETS=totals,w1,w2,draw
# Online GRU fine-tune step size (lower than cold-start to avoid best_epoch=1 rejects).
NEURALBET_LEARNING_RATE=5e-5
# GRU device: auto (CUDA if the driver is visible), cuda, or cpu.
# docker-compose.yml defaults to cpu; the cuda overlay defaults to auto.
NEURALBET_DEVICE=cpu
# CPU intra-op threads. Default is 4 on CUDA, 16 on CPU.
NEURALBET_TORCH_THREADS=16

# Checkpoint gate & stable validation (model.py / pipeline.py)
# Primary gate metric = mean in-band Brier; floor slack vs last accepted Brier.
NEURALBET_CHECKPOINT_VAL_FLOOR_TOLERANCE=0.02
NEURALBET_CHECKPOINT_BRIER_EPS=1e-4
# After N consecutive rejected online GRU passes: freeze GRU, probe once every M cycles
# so catch-up is not deadlocked (accept clears streak; reject re-enters cooldown).
NEURALBET_CHECKPOINT_REJECT_STREAK_ALERT=10
NEURALBET_CHECKPOINT_REJECT_PROBE_EVERY_CYCLES=20
NEURALBET_VAL_PIN_REFRESH_SECONDS=86400
NEURALBET_VAL_CUTOFF_SEED=42

# Cutoff policy & totals features (shared/neurobet_features/view.py)
NEURALBET_TRAIN_MIN_HISTORY=3

# Cold-start streaming (one pass per chunk; val/checkpoint after full cold-pool epoch)
NEURALBET_COLD_START_EPOCHS=2
NEURALBET_COLD_START_CHUNK=40000
# Oldest fraction of train-universe events used as the cold-start pool (rest stay
# trained_count=0 for online catch-up after cold-start finishes).
NEURALBET_COLD_START_ARCHIVE_FRACTION=0.70
# Deprecated — ignored; streaming always does one pass per chunk.
NEURALBET_COLD_START_INNER_EPOCHS=1
NEURALBET_COLD_START_LR=1e-3
NEURALBET_COLD_START_LR_DECAY=0.3

# Decision-head & paired-market loss (model.py)
# Objective B: EV verdict from calibrated p; residual decision loss off (also skips
# decision_threshold / sport_threshold tuner sweeps).
NEURALBET_DECISION_LOSS_WEIGHT=0.0
NEURALBET_DECISION_POS_WEIGHT_CAP=1.0
NEURALBET_PAIRED_MARKET_LOSS_WEIGHT=0.15

# Bankroll training loss ablation (bankroll.py / pipeline.py)
BANKROLL_LOSS_WEIGHT=0.35
BANKROLL_LOSS_CLIP=3.0
NEURALBET_BANKROLL_LOSS_DISABLED_PASSES=0
# Stake = fraction of equity (balance + locked). Floor / ceiling per position.
# MAX_*_POSITIONS=0 disables the open-bet count cap (still one bet per event).
BANKROLL_MIN_STAKE_FRACTION=0.10
BANKROLL_MAX_POSITION_FRACTION=0.25
BANKROLL_MAX_OPEN_POSITIONS=0
BANKROLL_MAX_POSITIONS=0

# Team form / stats caches for LightGBM + GRU KB (shared/neurobet_features/)
NEURALBET_TEAM_FORM_WINDOW=40
NEURALBET_TEAM_STATS_WINDOW=40
NEURALBET_LGB_DISABLE_TEAM_FEATURES=0

# Strict OOS backtest (backtest.py)
NEURALBET_OOS_TEST_EVENT_FRACTION=0.15
NEURALBET_OOS_MIN_EVENTS=40
NEURALBET_BOOTSTRAP_SAMPLES=500
NEURALBET_BOOTSTRAP_SEED=42
NEURALBET_WALK_FORWARD_FOLDS=4
NEURALBET_WALK_FORWARD_REGION_FRACTION=0.40
NEURALBET_QUALITY_GATE_MIN_CONSECUTIVE=2
NEURALBET_QUALITY_GATE_MIN_SAMPLES=80000
NEURALBET_QUALITY_GATE_MAX_AGE_HOURS=12
NEURALBET_QUALITY_GATE_SAMPLE_TOLERANCE=0.25
NEURALBET_SCHEDULED_BACKTEST_LIMIT=80000
# Cron (Moscow): every 3 hours on the hour.
NEURALBET_SCHEDULED_BACKTEST_CRON_HOURS=*/3
NEURALBET_SCHEDULED_BACKTEST_CRON_MINUTES=0
NEURALBET_BACKTEST_DEFAULT_LIMIT=80000

# Checkpoint gate — live coefficient band only on validation (model.py)
NEURALBET_CHECKPOINT_IN_BAND_ONLY=1
NEURALBET_THRESHOLD_BOOTSTRAP_SAMPLES=200

# Deploy mode: prod (inference + model registry) | dev (full training/backtest)
NEUROBET_DEPLOY_MODE=prod

NEXT_PUBLIC_BASE_PATH=/diflector/neurobet
NEXT_PUBLIC_API_URL=/diflector/neurobet
NEXT_PUBLIC_DEPLOY_MODE=prod
