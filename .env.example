# ==========================================
# NeuroBet System Environment Template
# ==========================================

# DeepSeek Web Session Token
DEEPSEEK_TOKEN=your_deepseek_token_here

# Postgres Settings
POSTGRES_USER=autobet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=autobet
DATABASE_URL=postgresql://autobet:change_me@postgres:5432/autobet

# Backend Settings
SCRAPE_INTERVAL_SECONDS=60

# AI Training Tuning (ai_service/app/neuralbet/{pipeline,model}.py) — cadence and batch
# sizing for the online trainer. Defaults below match what's currently running in
# production; see those files' comments at each constant's definition for why. Safe to
# omit entirely — every one of these falls back to the same default in code if unset.
NEURALBET_TRAIN_EVERY_CYCLES=20
NEURALBET_TRAIN_CATCHUP_EVERY_CYCLES=2
NEURALBET_TRAIN_CATCHUP_UNTIL_RATIO=0.80
NEURALBET_MIN_TRAIN_SAMPLES=2000
NEURALBET_MIN_FRESH_SAMPLES=500
NEURALBET_LIVE_QUALITY_GATE=1
NEURALBET_LIVE_QUALITY_MIN_BETS=40
NEURALBET_VAL_BATCH_LIMIT=2000
NEURALBET_BATCH_SIZE=256
NEURALBET_LGB_TRAIN_LIMIT=40000
NEURALBET_LGB_REFIT_EVERY_CYCLES=20
NEURALBET_LGB_MIN_FRESH_SAMPLES=500
NEURALBET_LGB_MAX_AGE_HOURS=1
NEURALBET_LGB_SEED=42
NEURALBET_LGB_BRIER_TOLERANCE=0.001
NEURALBET_TUNE_EVERY_CYCLES=10
NEURALBET_LIVE_STAKE_SPORTS=настольный теннис

# Checkpoint gate & stable validation (model.py / pipeline.py)
NEURALBET_CHECKPOINT_VAL_FLOOR_TOLERANCE=0.02
NEURALBET_VAL_PIN_REFRESH_SECONDS=86400
NEURALBET_VAL_CUTOFF_SEED=42

# Cutoff policy & totals features (shared/neurobet_features/view.py)
NEURALBET_TRAIN_MIN_HISTORY=3

# Cold-start streaming (one pass per chunk; val/checkpoint after full archive epoch)
NEURALBET_COLD_START_EPOCHS=2
NEURALBET_COLD_START_CHUNK=40000
# Deprecated — ignored; streaming always does one pass per chunk.
NEURALBET_COLD_START_INNER_EPOCHS=1
NEURALBET_COLD_START_LR=1e-3
NEURALBET_COLD_START_LR_DECAY=0.3

# Decision-head & paired-market loss (model.py)
NEURALBET_DECISION_POS_WEIGHT_CAP=1.0
NEURALBET_PAIRED_MARKET_LOSS_WEIGHT=0.15

# Bankroll training loss ablation (bankroll.py / pipeline.py)
BANKROLL_LOSS_WEIGHT=0.35
BANKROLL_LOSS_CLIP=3.0
NEURALBET_BANKROLL_LOSS_DISABLED_PASSES=0

# Team form cache for LightGBM (shared/neurobet_features/team_form.py)
NEURALBET_TEAM_FORM_WINDOW=40
NEURALBET_LGB_DISABLE_TEAM_FEATURES=0

# Strict OOS backtest (backtest.py)
NEURALBET_OOS_TEST_EVENT_FRACTION=0.15
NEURALBET_OOS_MIN_EVENTS=40
NEURALBET_BOOTSTRAP_SAMPLES=500
NEURALBET_BOOTSTRAP_SEED=42
NEURALBET_WALK_FORWARD_FOLDS=4
NEURALBET_WALK_FORWARD_REGION_FRACTION=0.40
NEURALBET_QUALITY_GATE_MIN_CONSECUTIVE=2
NEURALBET_QUALITY_GATE_MIN_SAMPLES=80000
NEURALBET_QUALITY_GATE_MAX_AGE_HOURS=12
NEURALBET_QUALITY_GATE_SAMPLE_TOLERANCE=0.25
NEURALBET_SCHEDULED_BACKTEST_LIMIT=80000
NEURALBET_BACKTEST_DEFAULT_LIMIT=80000

# Checkpoint gate — live coefficient band only on validation (model.py)
NEURALBET_CHECKPOINT_IN_BAND_ONLY=1
NEURALBET_THRESHOLD_BOOTSTRAP_SAMPLES=200


NEXT_PUBLIC_BASE_PATH=/neurobet
NEXT_PUBLIC_API_URL=/neurobet
