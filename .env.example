# ==============================================================================
# Neurobet (Нейроставки) — Environment Configuration Template
# All timestamps in the system are strictly in UTC.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# Network & Host Ports on necrolich.ru (192.168.1.92)
FRONTEND_PORT=8085
BACKEND_PORT=8005
POSTGRES_PORT=5435
REDIS_PORT=6385
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9006

# Primary Sport Focus (Sport #1: Tennis)
PRIMARY_SPORT=tennis
SUPPORTED_SPORTS=tennis

# PostgreSQL + TimescaleDB (Dedicated container)
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_DB=neurobet
POSTGRES_USER=neurobet
POSTGRES_PASSWORD=neurobet_secure_pass

# Redis & Redis Streams
REDIS_HOST=redis
REDIS_INTERNAL_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage (Raw snapshots & documents)
MINIO_HOST=minio
MINIO_INTERNAL_PORT=9000
MINIO_ACCESS_KEY=neurobet_minio
MINIO_SECRET_KEY=neurobet_minio_secret_pass
MINIO_BUCKET_RAW=raw-snapshots
MINIO_BUCKET_RESEARCH=research-documents

# Fonbet Collector Settings
FONBET_POLL_MIN_SECONDS=5.0
FONBET_POLL_MAX_SECONDS=10.0
FONBET_MAX_CONCURRENCY=4
FONBET_REQUEST_TIMEOUT_SECONDS=15
COLLECTOR_HEADLESS=true

# Neural / Machine Learning Configuration
ML_MIN_EDGE=0.03
ML_MIN_CONFIDENCE=0.60
MAX_ODDS_AGE_SECONDS=8

# Tennis Model Configuration
TENNIS_PRIMARY_MARKET=match_winner
TENNIS_ALLOW_LIVE_TRADING=true

# Bet Manager & Risk Policy (Simulation / Paper Trading Only)
BET_MODE=SIMULATION

# Server-side admin login for manual identity/match confirmations.
# Set ADMIN_PASSWORD_SHA256 to the lowercase SHA-256 hex digest of the admin password.
# Generate ADMIN_SESSION_SECRET with: openssl rand -hex 32
ADMIN_USERNAME=username
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
ADMIN_INTERNAL_TOKEN=
ADMIN_COOKIE_SECURE=true
INITIAL_BANKROLL=1000.00
MIN_STAKE=50
MAX_STAKE_FRACTION=0.20
MAX_EVENT_EXPOSURE_FRACTION=0.02
MAX_DAILY_LOSS_FRACTION=0.05

# Local LLM Context Analysis (NVIDIA GTX 1050 Ti - 4GB VRAM)
LLM_HOST=llm
LLM_PORT=8000
LLM_MODEL_PATH=/models/checkpoints/qwen2.5-3b-instruct-q4_k_m.gguf
LLM_CONTEXT_SIZE=4096
LLM_GPU_LAYERS=auto
LLM_REQUIRED=false

# Web Research Pipeline
RESEARCH_ENABLED=true
RESEARCH_MAX_PAGES=5
RESEARCH_MAX_AGE_SECONDS=86400
RESEARCH_TIMEOUT_SECONDS=10
# Research reaches the host proxy through a relay bound to this project's public-bridge gateway.
# Override RESEARCH_HTTP_PROXY only when deploying a separately reachable licensed proxy.
RESEARCH_HTTP_PROXY=
NEUROBET_PUBLIC_GATEWAY=172.26.0.1
RESEARCH_PROXY_PORT=17890
HOST_HTTP_PROXY_PORT=7890
# Keep internal Docker service names out of this proxy (Research sets this by default).
NO_PROXY=localhost,127.0.0.1,minio,postgres,redis,searxng,backend,worker,neural,bet-manager
# ddg | searxng | hybrid (оба параллельно → общий пакет для LLM) | mock
RESEARCH_SEARCH_BACKEND=hybrid
RESEARCH_SEARXNG_URL=http://searxng:8080
RESEARCH_PERSIST_DB=true
# Optional comma-separated Flashscore tennis player results URLs. Empty disables scraping.
FLASHSCORE_TENNIS_PROFILE_URLS=
FLASHSCORE_TENNIS_REQUEST_DELAY_SECONDS=2
FLASHSCORE_SOURCE_LOCK_WAIT_SECONDS=300
FLASHSCORE_ARCHIVE_MAX_WAIT_SECONDS=10
FLASHSCORE_TENNIS_PROFILE_TIMEOUT_SECONDS=300
FLASHSCORE_TENNIS_POINT_POLL_SECONDS=30
FLASHSCORE_TENNIS_POINT_CONCURRENCY=2
FLASHSCORE_TENNIS_PROFILE_CONCURRENCY=2
FLASHSCORE_DISCOVERY_SECONDS=15
FLASHSCORE_TENNIS_IMPORT_INTERVAL_SECONDS=86400
TENNIS_PLAYER_REFRESH_INTERVAL_SECONDS=3600
TENNIS_PLAYER_JOB_DISPATCH_SECONDS=5
# Secret for private SearXNG instance (internal network only)
SEARXNG_SECRET=change_me_to_a_long_random_string
