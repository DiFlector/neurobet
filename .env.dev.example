# ==========================================
# NeuroBet DEV stack — шаблон
# ==========================================
# Создание из prod:
#   cp .env .env.dev
#   затем заменить ключи ниже (или: cp .env .env.dev && apply diff)
#
# Start:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml \
#     -p neurobet-dev --env-file .env.dev up --build -d

NEUROBET_DEPLOY_MODE=dev

# Postgres — отдельная БД (volume ./data-dev/postgres)
POSTGRES_USER=autobet
POSTGRES_PASSWORD=autobet
POSTGRES_DB=autobet_dev
DATABASE_URL=postgresql://autobet:autobet@postgres:5432/autobet_dev

# Общий архив finished_events + finished_bets (prod Postgres). Live — autobet_dev.
ARCHIVE_DATABASE_URL=postgresql://autobet:autobet@neurobet_postgres:5432/autobet

# Frontend — https://necrolich.ru/diflector/dev/neurobet/
NEXT_PUBLIC_BASE_PATH=/diflector/dev/neurobet
NEXT_PUBLIC_API_URL=/diflector/dev/neurobet
NEXT_PUBLIC_DEPLOY_MODE=dev

# Все NEURALBET_* / BANKROLL_* / SCRAPE_* — обычно те же, что в prod .env
